{
  "name": "spend-smart",
  "version": "1.0.0",
  "description": "SpendSmart - Student Expense Tracker (MERN Stack)",
  "private": true,
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install --include=dev",
    "install:all": "npm install && npm run install:server && npm run install:client",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "build": "npm run install:all && npm run build:client",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "keywords": [
    "mern",
    "expense-tracker",
    "student-budget",
    "react",
    "express",
    "mongodb"
  ],
  "author": "ICTAK Student Intern",
  "license": "MIT"
}
