# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/spend-smart
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/spend-smart?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spend-smart

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_strong_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
